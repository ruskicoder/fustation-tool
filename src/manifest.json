{
  "manifest_version": 3,
  "name": "fustation-tool",
  "version": "1.0.0",
  "description": "Extract exam question banks from fustation.net into clean Markdown, PDF, and JSON files",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "activeTab",
    "scripting",
    "webRequest",
    "webNavigation"
  ],
  "host_permissions": [
    "*://*.fustation.net/*",
    "*://fustation.net/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.fustation.net/*",
        "*://fustation.net/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "assets/content.css"
      ],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "assets/*"
      ],
      "matches": [
        "*://*.fustation.net/*",
        "*://fustation.net/*"
      ]
    }
  ]
}
