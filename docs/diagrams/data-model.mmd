        string id
        string title
        string subjectCode
        string subjectName
        string author
        string examCategory "FE or PE"
        string pdfUrl
        string zipUrl
        string examSessionDate
        int totalQuestions
        bool isPartial
    }
    QUESTION {
        int index
        string id
        string text
        string imageUrl
        string imageBase64
        string correctAnswers
    }
