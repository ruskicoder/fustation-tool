        string id
        string extractedAt
    }
    BATCH_ITEM_TASK {
        string id "CUID"
        string examUrl
        string rscUrl
    }
    BATCH_STATE {
        string status
        int previewCount
        int totalDiscovered
        int completedCount
    }
